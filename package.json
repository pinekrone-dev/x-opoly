{
  "name": "sitesurvey-cre",
  "private": true,
  "version": "1.0.0",
  "description": "Site survey and deal mapping for tenant rep brokers — map candidate properties, track deal stages, plan tours, and share a branded client link.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && npm start",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cheerio": "^1.0.0",
    "d3-hierarchy": "^3.1.2",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "playwright-core": "^1.49.0"
  }
}
