# Copy to .env.local (gitignored) and fill in only what you use.
# Every value is optional: the app and the data scripts run without any of them.
# Never commit a filled-in copy. On Cloudflare, set these as Worker secrets instead.

# --- app: optional integrations (see README "Configuration") -------------------
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROK_API_KEY=
GROK_MODEL=
GOOGLE_MAPS_API_KEY=
GOOGLE_REFERER=
CENSUS_API_KEY=
TILE_PROVIDER=osm
TILE_KEY=
TILE_STYLE=
TILE_URL=
TILE_ATTRIBUTION=
TILE_MAX_ZOOM=
TILE_DARK=
GEOCODER_URL=
GEOCODER_KEY=
GEOCODER_UA=
OVERPASS_URL=
PLACES_UA=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXEMPT_EMAILS=
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SIGNUP_TOKEN=

# --- app: Node runtime only ------------------------------------------------------
DATA_DIR=
DB_FILE=
PORT=

# --- data procurement (scripts/procure-data.mjs) --------------------------------
# No keys are needed for NPPES or NUCC. Behind an HTTPS proxy, Node's fetch
# needs this to honour HTTPS_PROXY.
NODE_USE_ENV_PROXY=1
# Only if a later, approved step pulls the SAM.gov public entity extract, which
# requires a free personal api.data.gov key. Unset means that step is skipped.
SAM_GOV_API_KEY=
