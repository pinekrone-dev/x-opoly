# Static files Cloudflare serves without running the Worker (index.html, the
# built bundles, the public pages) get the same headers worker/index.js adds
# to everything it answers. Keep the two lists in step.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), payment=(self)
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# The service worker is checked on every open, so a deploy reaches an
# installed app the next time it is opened.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
